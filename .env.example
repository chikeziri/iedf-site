# Copy this file to .env.local and fill in real values before running the app
# against live services. The app runs and builds fine without these — forms
# log to console and content reads from lib/content/ stubs until wired up.

# Site URL — used for resolving absolute Open Graph/social image URLs.
# Update once a custom domain is confirmed (Brief, Open Question 3).
NEXT_PUBLIC_SITE_URL=https://iedf.org.ng

# Sanity (CMS) — see lib/sanity/client.ts
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Database. WhoGoHost MySQL (URL-encode the password if it contains @ : / # or spaces):
#   mysql://iedforgn_db_user:PASSWORD@localhost:3306/iedforgn_db
# Neon Postgres still works with a postgres:// URL.
DATABASE_URL=

# WhoGoHost mailbox. Contact alerts go to ADMIN_NOTIFICATION_EMAIL.
# Replies and form notices are sent from SMTP_USER (noreply@).
SMTP_HOST=mail.iedf.org.ng
SMTP_PORT=587
SMTP_USER=noreply@iedf.org.ng
SMTP_PASSWORD=
SMTP_FROM=IEDF <noreply@iedf.org.ng>
ADMIN_NOTIFICATION_EMAIL=info@iedf.org.ng

# Optional. Used only when SMTP_PASSWORD is empty.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Newsletter ESP — provider TBD, Buttondown or Mailchimp
NEWSLETTER_API_KEY=

# Cloudflare Turnstile (spam protection) — not wired yet
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Admin console at /admin — Bearer token for /api/admin/submissions
ADMIN_SECRET=

# Paystack payment gateway (donations)
# Test keys start with pk_test_/sk_test_, live keys with pk_live_/sk_live_
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
